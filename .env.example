# ==============================================================================
# PORTAL NACIONAL DE ENTRETENIMENTO ADULTO 18+ — ENVIRONMENT TEMPLATE
# ==============================================================================
# All values must be supplied for production deployment.
# NEVER commit real credentials or keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SUPABASE CONFIGURATION (Public & Private)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. SITE & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://portalnacional.com.br
APP_ENV=production

# ------------------------------------------------------------------------------
# 3. IDENTITY & AGE VERIFICATION (KYC 18+ PROVIDER)
# ------------------------------------------------------------------------------
KYC_PROVIDER=unconfigured
KYC_API_URL=
KYC_API_KEY=
KYC_WEBHOOK_SECRET=
KYC_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 4. SPECIALIZED ADULT PAYMENT PROCESSOR
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=unconfigured
PAYMENT_API_URL=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL PROVIDER
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=fallback
EMAIL_FROM_ADDRESS=nao-responda@portalnacional.com.br
EMAIL_FROM_NAME="Portal Nacional"
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_API_KEY=

# ------------------------------------------------------------------------------
# 6. EXTERNAL STORAGE OBJECT BACKUP (S3 COMPATIBLE)
# ------------------------------------------------------------------------------
STORAGE_BACKUP_S3_ENDPOINT=
STORAGE_BACKUP_S3_BUCKET=
STORAGE_BACKUP_S3_ACCESS_KEY=
STORAGE_BACKUP_S3_SECRET_KEY=
STORAGE_BACKUP_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 7. WEB PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@portalnacional.com.br
