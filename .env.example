# ==========================================
# PORTAL NACIONAL 18+ — ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# PUBLIC (Exposed to browser / client-side)
# ------------------------------------------
# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Chave anônima pública (anon key) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL base da aplicação
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------
# PRIVATE (Strictly server-side only)
# NUNCA expor no bundle do navegador!
# ------------------------------------------
# Service role key do Supabase (Privilégios administrativos plenos / bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Conexão direta PostgreSQL (opcional para migrations ou scripts)
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Ambiente (development, staging, production)
NODE_ENV=development
